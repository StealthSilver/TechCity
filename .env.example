# SMTP — required for trainer + partner application emails
# Example below is for Gmail. Use an App Password (not your normal password).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to true only when using port 465
SMTP_SECURE=false
SMTP_USER=techcityskillspvt.ltd@gmail.com
SMTP_PASS=your-gmail-app-password

# Optional. Defaults to SMTP_USER if omitted.
SMTP_FROM="TechCity <techcityskillspvt.ltd@gmail.com>"

# Inbox that receives trainer + partner applications.
# Defaults to techcityskillspvt.ltd@gmail.com if omitted.
MAIL_TO=techcityskillspvt.ltd@gmail.com
